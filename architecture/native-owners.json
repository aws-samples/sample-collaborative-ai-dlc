{
  "schemaVersion": 1,
  "records": {
    "RUNTIME": {
      "owner": "native-authority",
      "commands": ["commands:create", "commands:prepare", "commands:savePrompt"],
      "observations": ["preparation:claim/advance/release/fail/ready"],
      "role": "authority",
      "adapters": ["api", "worker"]
    },
    "EXECUTION": {
      "owner": "native-authority",
      "commands": ["commands:start/respond/cancel/recover"],
      "observations": [
        "execution:claim/advance/dispatchAttempted/dispatched/recoveryStopped/recovered/recoveryRequired/publish"
      ],
      "role": "authority",
      "adapters": ["execution_worker", "cancellation_worker"]
    },
    "RESPONSE/PUBLICATION/ANSWER": {
      "owner": "native-authority",
      "kind": "immutable transactional history",
      "role": "authority"
    },
    "PROMPT": {
      "owner": "native-authority",
      "kind": "immutable transactional prompt-save receipts",
      "role": "authority"
    },
    "OUTPUT/OUTPUT_CURSOR": {
      "owner": "native-authority",
      "observations": ["execution:activity.ingest"],
      "role": "authority"
    },
    "EVENT": {
      "owner": "native-authority",
      "kind": "public lifecycle facts committed atomically with EXECUTION; never scheduling authority",
      "role": "authority"
    },
    "PROJECTION": {
      "owner": "native-authority",
      "observations": ["projection:claim/acknowledge/release"],
      "role": "authority",
      "effectRole": "projection"
    },
    "REVOCATION": {
      "owner": "operator",
      "partition": "NATIVE_RUNTIME_IMAGE#*",
      "role": "operator only"
    },
    "DiscussionMessage": {
      "owner": "discussions",
      "observations": ["assist-result:request/attempt-bound completion"],
      "role": "discussions",
      "limit": "Shared platform runtime retains legacy graph permissions; Quorum module bypass forbidden by code review/check"
    },
    "workflow-files": {
      "owner": "admitted runtime generation",
      "limit": "same UID tools share write authority"
    },
    "Yjs": {
      "owner": "Yjs persistence",
      "limit": "drafts only"
    },
    "RESULT": {
      "owner": "native-authority",
      "kind": "derived download jobs; no workflow completion authority",
      "role": "authority",
      "observations": ["results:claim/finish"]
    },
    "REPAIR_CHECKPOINT": {
      "owner": "native-repair-scan",
      "kind": "hint cursor in separate repair table; never job or execution authority",
      "role": "wakeup:runtime / native_package_repair:packages",
      "observations": [
        "conditional claim/checkpoint/release; expired lease takeover; failed rows revisit next sweep"
      ]
    }
  },
  "controlWriters": [
    "lambda/native-runtime-control/store.js",
    "lambda/native-runtime-control/execution-store.js",
    "lambda/native-runtime-control/activity-store.js",
    "lambda/native-runtime-control/projection-store.js",
    "lambda/native-runtime-control/result-store.js"
  ],
  "mutatorModules": {
    "lambda/native-runtime-control/store.js": "createNativeRuntimeStore",
    "lambda/native-runtime-control/execution-store.js": "createNativeExecutionStore",
    "lambda/native-runtime-control/activity-store.js": "createNativeActivityStore",
    "lambda/native-runtime-control/projection-store.js": "createNativeProjectionStore",
    "lambda/native-runtime-control/result-store.js": "createNativeResultStore"
  },
  "mutatorFactories": {
    "createNativeRuntimeStore": [
      "lambda/native-runtime-control/authority.js",
      "lambda/native-runtime-control/command-service.js",
      "lambda/native-runtime-control/execution-credentials-entry.js"
    ],
    "createNativeExecutionStore": [
      "lambda/native-runtime-control/authority.js",
      "lambda/native-runtime-control/command-service.js",
      "lambda/native-runtime-control/execution-credentials-entry.js"
    ],
    "createNativeActivityStore": [
      "lambda/native-runtime-control/authority.js",
      "lambda/native-runtime-control/command-service.js"
    ],
    "createNativeProjectionStore": [
      "lambda/native-runtime-control/authority.js",
      "lambda/native-runtime-control/command-service.js"
    ],
    "createNativeResultStore": [
      "lambda/native-runtime-control/authority.js",
      "lambda/native-runtime-control/command-service.js"
    ]
  },
  "complexityExceptions": {
    "lambda/agentcore/commands/run-stage.js:/runStageAttempt:1": {
      "maximum": 254,
      "reason": "Inherited unchanged from main 1a5f8ae8; the merge-base score was 252. Preserve stage side-effect ordering during this merge; further complexity growth remains blocked."
    },
    "lambda/intents/index.js:/handler:1": {
      "maximum": 557,
      "reason": "Main 1a5f8ae8 adds 44 to the merge-base score of 507; the existing native branch adds 6. Preserve the native backend boundary and the upstream settings and gate contracts; further complexity growth remains blocked."
    },
    "lambda/shared/v2-process-store.js:/createProcessStore/updateExecution:1": {
      "maximum": 81,
      "reason": "Inherited unchanged from main 1a5f8ae8; the merge-base score was 72. Preserve atomic run/stage ownership conditions during this merge; further complexity growth remains blocked."
    },
    "lambda/v2-orchestrator/index.js:/handler:1": {
      "maximum": 98,
      "reason": "Main 1a5f8ae8 adds 7 to the merge-base score of 89; the existing native branch adds 2. Preserve durable replay names/order and gate recovery during this merge; further complexity growth remains blocked."
    },
    "lambda/v2-orchestrator/index.js:/handler/executeStage:1": {
      "maximum": 23,
      "reason": "Inherited unchanged from main 860cdc60. Preserve durable replay names/order and gate recovery during this merge; further complexity growth remains blocked."
    }
  }
}
