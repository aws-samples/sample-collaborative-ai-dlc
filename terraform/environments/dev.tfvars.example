environment = "dev"
aws_region  = "us-east-1"

# Keep only Lambdas already requiring private resources in the VPC. Set to
# "public-egress" to also route OAuth connectors, credential resolution, and
# seed-blocks through NAT.
lambda_vpc_scope = "required"

# Bedrock model pinning (for claude and opencode drivers)
bedrock_model = "us.anthropic.claude-sonnet-4-6"

# Codex model. Must be a cross-Region inference profile id: Codex calls Bedrock's
# OpenAI-compatible Responses API, which refuses a bare foundation-model id.
codex_model = "global.openai.gpt-5.6-sol"

# ---------------------------------------------------------------------------
# Bedrock IAM-role credential mode (optional)
#
# A Bedrock binding can name an IAM role instead of storing an API key; the
# credential broker assumes it per agent invocation. Terraform does NOT create
# that role - it may live in another account, and its trust policy is the
# operator's control over who may assume it. Get the permission policy from
# `terraform output -raw bedrock_role_grant_policy_json` and the principal to
# trust from `terraform output -raw credential_broker_role_arn`.
#
# The broker may only assume roles matching these ARN patterns, so either name
# the role `aidlc-bedrock-*` or widen this list. Leave commented for the default.
# bedrock_assumable_role_arns = ["arn:aws:iam::*:role/aidlc-bedrock-*"]
#
# Set only when the role lives in a different account from this deployment (the
# central-Bedrock-account topology). An external ID is then required, and the
# platform generates it. Empty = this deployment's own account.
# bedrock_role_account_id = ""
#
# Narrows the rendered trust policy to named spaces, for a SPACE-SCOPE binding.
# Leave empty for the shared form, which is the only one a platform-scope binding
# can use. Ids are the space ids from the space URLs.
# bedrock_role_trusted_space_ids = []
# ---------------------------------------------------------------------------

# ---------------------------------------------------------------------------
# Custom domain (optional)
#
# Leave app_domain empty to serve on the CloudFront-assigned *.cloudfront.net
# domain. That is the default and requires no certificate, no DNS and no
# additional resources.
#
# All four values can also be supplied by the installer:
#   install.sh install --domain aidlc.example.com --certificate-arn arn:...
#   install.sh install --domain aidlc.example.com --hosted-zone-id Z1234567890ABC
#
# Bring your own certificate (central certificate management, imported
# certificates, wildcards, private CA) and manage DNS wherever you like. Point
# the hostname's A/AAAA alias (or CNAME) at the `dns_target` output afterwards:
#
#   app_domain          = "aidlc.example.com"
#   acm_certificate_arn = "arn:aws:acm:us-east-1:111122223333:certificate/..."
#
# Or let Terraform request and DNS-validate the certificate and create the
# records, which requires the hosted zone to live in this account:
#
#   app_domain      = "aidlc.example.com"
#   route53_zone_id = "Z1234567890ABC"
#
# app_domain is canonical: it drives the OAuth redirect URIs and the frontend
# build, so it must be a single hostname. app_domain_aliases adds extra names
# to the same distribution (e.g. ["www.aidlc.example.com"]).
#
# The certificate must be in us-east-1 — CloudFront accepts no other region.
# ---------------------------------------------------------------------------
app_domain          = ""
app_domain_aliases  = []
acm_certificate_arn = ""
route53_zone_id     = ""

# Authentication defaults to the existing Cognito email/password flow.
# For enterprise federation set auth_mode to "hybrid" or "sso-only" and add
# providers here, or pass --auth-mode and --sso-config to deploy-terraform.sh.
auth_mode     = "local"
sso_providers = {}
