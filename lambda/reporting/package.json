{
  "name": "reporting",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "vitest run --project=reporting",
    "test:watch": "vitest --project=reporting",
    "build": "npm run build:transform && npm run build:backfill && npm run build:views",
    "build:transform": "esbuild transform.js --bundle --platform=node --target=node24 --format=esm --banner:js=\"import{createRequire}from'node:module';const require=createRequire(import.meta.url);\" --outfile=.build/transform/index.mjs",
    "build:backfill": "esbuild backfill.js --bundle --platform=node --target=node24 --format=esm --banner:js=\"import{createRequire}from'node:module';const require=createRequire(import.meta.url);\" --outfile=.build/backfill/index.mjs",
    "build:views": "esbuild views.js --bundle --platform=node --target=node24 --format=esm --banner:js=\"import{createRequire}from'node:module';const require=createRequire(import.meta.url);\" --outfile=.build/views/index.mjs",
    "lint": "oxlint .",
    "format": "oxfmt .",
    "format:check": "oxfmt --check ."
  },
  "dependencies": {
    "@aws-lambda-powertools/logger": "^2.35.0",
    "@aws-sdk/client-athena": "^3.1106.0",
    "@aws-sdk/client-dynamodb": "^3.1106.0",
    "@aws-sdk/client-s3": "^3.1106.0"
  }
}
