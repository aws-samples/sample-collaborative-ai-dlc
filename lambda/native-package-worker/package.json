{
  "name": "native-package-worker",
  "private": true,
  "type": "module",
  "main": "index.js",
  "scripts": {
    "test": "vitest run --project=native-package-worker",
    "build": "esbuild index.js --bundle --platform=node --target=node24 --format=esm --banner:js=\"import{createRequire}from'node:module';const require=createRequire(import.meta.url);\" --outfile=.build/index.mjs",
    "build:storage-probe": "esbuild storage-probe.js --bundle --platform=node --target=node24 --format=esm --banner:js=\"import{createRequire}from'node:module';const require=createRequire(import.meta.url);\" --outfile=.probe-build/index.mjs",
    "lint": "oxlint .",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "build:repair": "esbuild repair.js --bundle --platform=node --target=node24 --format=esm --banner:js=\"import{createRequire}from'node:module';const require=createRequire(import.meta.url);\" --outfile=.repair-build/repair.mjs"
  },
  "dependencies": {
    "@aws-lambda-powertools/logger": "^2.35.0",
    "@aws-sdk/client-dynamodb": "^3.1092.0",
    "@aws-sdk/client-s3": "^3.1092.0",
    "@aws-sdk/client-secrets-manager": "^3.1092.0",
    "@aws-sdk/client-sqs": "^3.1092.0",
    "@aws-sdk/client-ssm": "^3.1092.0",
    "@aws-sdk/credential-providers": "^3.1092.0",
    "@aws-sdk/lib-dynamodb": "^3.1092.0",
    "gremlin": "^3.8.1",
    "gremlin-aws-sigv4": "^3.6.1",
    "tar-stream": "^3.2.0"
  }
}
