# AWS Configuration
VITE_AWS_REGION=us-east-1
VITE_AWS_USER_POOL_ID=your-user-pool-id
VITE_AWS_USER_POOL_CLIENT_ID=your-user-pool-client-id

# Canonical origin of the deployment. The custom domain when app_domain is set,
# otherwise the CloudFront domain. Used for the OAuth callback URLs shown in the
# Admin UI, which must match the redirect URIs the backend sends.
#   terraform output -raw application_url
VITE_APP_ORIGIN=https://your-app-domain.example.com

# Everything is same-origin behind the single CloudFront distribution, so all
# three endpoints below share the hostname from VITE_APP_ORIGIN. Routing /api/*
# through CloudFront is also what injects the X-Origin-Verify header, which the
# API Gateway resource policy can be configured to require.
#   terraform output -raw application_domain
VITE_API_BASE_URL=https://your-app-domain.example.com/api
VITE_WEBSOCKET_URL=wss://your-app-domain.example.com/ws
VITE_YJS_SERVER_URL=wss://your-app-domain.example.com/yjs

# Environment
VITE_ENVIRONMENT=development
