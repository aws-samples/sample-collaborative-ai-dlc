#!/usr/bin/env sh
# Pre-commit hook. Each optional check is gated so a missing tool, missing
# config, or missing dependency tree is a silent skip — never a blocked commit.
# CI is the enforcement layer; this hook is fast feedback for the author.
set -e

# Always-available checks (npm devDependencies).
npx lint-staged

# AWS SDK version alignment: only if a package.json is staged. The script has
# no dependencies (node:fs only), so no node_modules guard is needed.
staged_pkg=$(git diff --cached --name-only --diff-filter=ACMR | grep -E '(^|/)package\.json$' || true)
if [ -n "$staged_pkg" ]; then
  npm run sdk:check
fi

# Backend dependency rules: circular deps, cross-workspace imports, shared/ as a
# leaf, and no prod->test edges (dependency-cruiser). It is an npm
# devDependency so it always runs; gated on staged lambda/ source to keep
# unrelated commits fast. The whole graph is cruised, not just staged files,
# since these are cross-file structural rules.
staged_lambda=$(git diff --cached --name-only --diff-filter=ACMR | grep -E '^lambda/.*\.[cm]?js$' || true)
if [ -n "$staged_lambda" ]; then
  npm run dep:check
fi

# SCA on production deps. Root deps come with `npm install`, so this always
# runs. Frontend has its own package.json outside workspaces — skip silently
# if its node_modules don't exist.
# Audit failures are advisory in this local hook; findings remain visible.
if ! npm audit --omit=dev --audit-level=high; then
  echo "npm audit reported high-severity findings; continuing commit."
fi
if [ -d frontend/node_modules ]; then
  if ! npm --prefix frontend audit --omit=dev --audit-level=high; then
    echo "frontend npm audit reported high-severity findings; continuing commit."
  fi
fi

# Frontend type-check: only if frontend TS/TSX is staged AND deps are installed.
staged_frontend_ts=$(git diff --cached --name-only --diff-filter=ACMR | grep -E '^frontend/.*\.[cm]?tsx?$' || true)
if [ -n "$staged_frontend_ts" ] && [ -d frontend/node_modules ]; then
  npm run typecheck:frontend
fi

# Terraform: only if .tf is staged AND the binaries are present.
staged_tf=$(git diff --cached --name-only --diff-filter=ACMR | grep -E '^terraform/.*\.tf$' || true)
if [ -n "$staged_tf" ]; then
  if command -v terraform >/dev/null 2>&1; then
    terraform -chdir=terraform fmt -check -recursive
  fi
  if command -v tflint >/dev/null 2>&1; then
    # `tflint --init` is idempotent: ~50ms no-op when plugins are present, a
    # one-time download otherwise. If init fails (offline, plugin source
    # unreachable, etc.) we skip the lint run instead of blocking the commit.
    if tflint --chdir=terraform --init >/dev/null 2>&1; then
      tflint --chdir=terraform
    fi
  fi
fi

# Optional inner-loop SAST preview. CodeQL in CI is the enforcement layer;
# semgrep/opengrep here is just a fast local heads-up if installed.
staged_js=$(git diff --cached --name-only --diff-filter=ACMR | grep -E '\.[cm]?[jt]sx?$' || true)
if [ -n "$staged_js" ]; then
  if command -v opengrep >/dev/null 2>&1; then
    echo "$staged_js" | xargs opengrep scan --config=p/javascript --config=p/typescript --error --quiet --metrics=off
  elif command -v semgrep >/dev/null 2>&1; then
    echo "$staged_js" | xargs semgrep scan --config=p/javascript --config=p/typescript --error --quiet --metrics=off
  fi
fi

npx vitest run --changed --passWithNoTests

# Some tests read Terraform or scripts as text instead of importing them, so
# `--changed` cannot relate them to a staged change: run them when their
# inputs are staged. Deleted files count, since a test may read them.
staged_all=$(git diff --cached --name-only)
if echo "$staged_all" | grep -qE '^terraform/'; then
  terraform_vitest=$(git grep -l 'terraform/' -- 'lambda/*/test/*.test.js' || true)
  if [ -n "$terraform_vitest" ]; then
    # shellcheck disable=SC2086 # one test path per word
    npx vitest run $terraform_vitest
  fi
fi
if echo "$staged_all" | grep -qE '^scripts/'; then
  npm run test:release
elif echo "$staged_all" | grep -qE '^terraform/'; then
  terraform_node=$(git grep -l 'terraform/' -- 'scripts/test/*.test.mjs' || true)
  if [ -n "$terraform_node" ]; then
    # shellcheck disable=SC2086 # one test path per word
    node --test $terraform_node
  fi
fi
