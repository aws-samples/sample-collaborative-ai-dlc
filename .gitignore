# Terraform
.terraform/
.terraform.lock.hcl
# The root lock file makes CI and release deployments reproducible.
!terraform/.terraform.lock.hcl
*.tfstate
*.tfstate.*
*.tfplan
*.tfplan.*
tfplan
.terraformrc
terraform.rc
# Per-deployment backend config generated by ./scripts/bootstrap.sh
terraform/environments/*.s3.tfbackend
# Actual tfvars contain deployment-specific values; commit the .example files instead
terraform/environments/*.tfvars
!terraform/environments/*.tfvars.example
terraform/builds

# Environment variables
.env
.env.local
.env.*.local

# IDE / AI tooling
.vscode/
.idea/
.claude/
.kiro/
.coordination/
.beads/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Dependencies
node_modules

# Test coverage output
coverage/

# Dev screenshots and scratch files
*.png
# Curated public README screenshots
!docs/assets/readme/*.png

# Full-length README media is published externally, never committed.
docs/assets/readme/*.mp4
docs/assets/readme/*.mp3
docs/assets/readme/*.wav

ideas.txt
mise.toml

lambda/dist
lambda/*/.build/
lambda/native-package-worker/.probe-build/
test/fixtures/oidc-idp/.role-claim.zip

# Documentation build output
site/

# E2E test run artifacts (generated screenshots, reports, summaries)
test/e2e/artifacts/
frontend/public/dev/agent-output-fixtures.json

# Terraform plan files (any environment suffix)
tfplan*

# A7 local annex-check run artifacts (generated per-run; contain local paths)
lambda/agentcore/test/a7-prompt.txt
lambda/agentcore/test/a7-mcp-config.json
.native-evidence/

# Checkout-local short paths for Terraform Unix sockets
.native-tmp/

# dependency-cruiser generated reports
reports/dependency/

# Local Python test bytecode
__pycache__/

# Release architecture inventory is generated from one HEAD.
reports/architecture/

# Separate package repair Lambda bundle
lambda/native-package-worker/.repair-build/
